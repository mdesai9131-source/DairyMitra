# DairyMitra Environment Configuration Example

# Flask
FLASK_ENV=development
FLASK_APP=backend.app:create_app
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
JWT_SECRET_KEY=jwt-secret-key-change-in-production-min-32-chars-long
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Database (PostgreSQL)
DATABASE_URL=postgresql://dairymitra_user:dairymitra_pass@localhost:5432/dairymitra_db
# For local dev without Postgres:
# DATABASE_URL=sqlite:///dairymitra.db

# Email / SMTP Settings (for OTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=mdesai9131@gmail.com
MAIL_PASSWORD=dkocdpntwkzdfewk
MAIL_DEFAULT_SENDER=noreply@dairymitra.com

# In dev/mock mode, OTP can be logged to console without sending actual emails:
OTP_MOCK_MODE=True
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=

# AI / ML
AI_API_KEY=

# Server
PORT=5001
HOST=0.0.0.0
